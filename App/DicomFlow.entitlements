<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Store requires the App Sandbox. Fully native (DCMTK in-process),
         so no library-validation / JIT exceptions are needed. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outbound DICOM associations (C-ECHO/STORE/FIND/MOVE/GET). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Built-in test SCP listens for incoming associations. -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Open/save DICOM files and folders chosen by the user. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
